---
// Legal pages: placeholders, not indexed, until a lawyer validates the texts
// (docs/site.md §10). They must be written before the site goes live.
import { FileClock } from "@lucide/astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { LOCALES, PAGES, texts, type Locale } from "../../i18n";

// Astro runs getStaticPaths on its own: everything it needs is inside it.
export function getStaticPaths() {
  const documents = [
    [PAGES.notice, "notice"],
    [PAGES.privacy, "privacy"],
    [PAGES.terms, "terms"],
  ] as const;
  return LOCALES.flatMap((lang) =>
    documents.map(([legal, document]) => ({ params: { lang, legal }, props: { document } })),
  );
}

interface Props {
  document: "notice" | "privacy" | "terms";
}
const locale = Astro.params.lang as Locale;
const t = texts(locale);
const title = t.legal[Astro.props.document];
---

<Base locale={locale} title={title} noindex>
  <PageHeader title={title} />
  <div class="mx-auto max-w-3xl px-6 py-16">
    <p class="panel flex items-center gap-3 p-6 text-ash">
      <FileClock size={20} stroke-width={1.75} class="shrink-0 text-brand" aria-hidden="true" />
      {t.legal.pending}
    </p>
  </div>
</Base>
