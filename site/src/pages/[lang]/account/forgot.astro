---
// Forgotten password: request a reset link (docs/site.md §8).
import PageHeader from "../../../components/PageHeader.astro";
import Base from "../../../layouts/Base.astro";
import { isLocale, texts } from "../../../i18n";

export const prerender = false;

const lang = Astro.params.lang;
if (!isLocale(lang)) {
  return new Response(null, { status: 404 });
}
const a = texts(lang).account;
const status = Astro.url.searchParams.get("status");
const messages: Record<string, { tone: string; text: string }> = {
  "reset-sent": { tone: "border-ready/40 text-ready", text: a.status["reset-sent"] },
  invalid: { tone: "border-sayno/40 text-sayno", text: a.status.invalid },
  limited: { tone: "border-sayno/40 text-sayno", text: a.status.limited },
  expired: { tone: "border-sayno/40 text-sayno", text: a.status.expired },
  failed: { tone: "border-sayno/40 text-sayno", text: a.status.failed },
};
const notice = status ? messages[status] : undefined;
---

<Base locale={lang} title={a.forgotTitle} noindex>
  <PageHeader title={a.forgotTitle} lead={a.forgotLead} />
  <div class="mx-auto max-w-xl px-6 py-16">
    {notice && <p class={`mb-8 rounded-lg border px-4 py-3 text-sm ${notice.tone}`} role="status">{notice.text}</p>}
    <form method="post" action="/api/account/forgot" class="panel flex flex-col gap-5 p-8">
      <input type="hidden" name="lang" value={lang} />
      <label class="flex flex-col gap-1.5 text-sm font-bold">
        {a.email}
        <input
          class="w-full rounded-lg border border-edge bg-night px-3 py-2 text-sm font-normal text-soft focus:border-brand focus:outline-none"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
        />
      </label>
      <button type="submit" class="rounded-lg bg-brand px-4 py-2.5 text-sm font-bold text-white hover:bg-brand/85">
        {a.forgotSend}
      </button>
    </form>
  </div>
</Base>
