---
import { Download, HardDrive, UserRound } from "@lucide/astro";
import Badge from "../../components/Badge.astro";
import LinkButton from "../../components/LinkButton.astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { LOCALES, href, texts, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = texts(locale);
const d = t.download;
const systems = t.product.systems;
---

<Base locale={locale} title={d.title}>
  <PageHeader title={d.title} lead={d.lead} />

  <div class="mx-auto grid max-w-6xl gap-6 px-6 py-16 md:grid-cols-2">
    <section class="panel p-8">
      <div class="flex items-center gap-3">
        <Download size={22} stroke-width={1.75} class="text-brand" aria-hidden="true" />
        <Badge tone="neutral">{d.soon}</Badge>
      </div>
      <div class="mt-6 flex gap-3">
        <UserRound size={18} stroke-width={1.75} class="mt-0.5 shrink-0 text-ash" aria-hidden="true" />
        <p class="text-sm leading-relaxed text-ash">{d.account}</p>
      </div>
      <div class="mt-6">
        <LinkButton href={href(locale, "account")} variant="primary">{t.nav.account}</LinkButton>
      </div>
    </section>
    <section class="panel p-8">
      <div class="flex items-center gap-3">
        <HardDrive size={22} stroke-width={1.75} class="text-brand" aria-hidden="true" />
        <h2 class="text-lg font-bold">{systems.title}</h2>
      </div>
      <ul class="mt-4 flex flex-col gap-2 text-sm leading-relaxed text-ash">
        <li>{systems.deb}</li>
        <li>{systems.rpm}</li>
        <li>{systems.drives}</li>
      </ul>
    </section>
  </div>
</Base>
