---
import { BookCheck, Bug, FileCheckCorner, KeyRound, Lock, ScrollText } from "@lucide/astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { LOCALES, href, texts, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = texts(locale);
const s = t.security;
const blocks = [
  { icon: Lock, ...s.offline },
  { icon: KeyRound, ...s.chain },
  { icon: ScrollText, ...s.privacy },
];
---

<Base locale={locale} title={s.title}>
  <PageHeader title={s.title} lead={s.lead} />

  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-6 py-16">
    <section class="panel p-8">
      <div class="flex items-center gap-3">
        <BookCheck size={22} stroke-width={1.75} class="text-brand" aria-hidden="true" />
        <h2 class="text-xl font-bold">{s.standards.title}</h2>
      </div>
      <p class="mt-3 max-w-3xl leading-relaxed text-ash">{s.standards.text}</p>
      <p class="mt-4 max-w-3xl border-l-2 border-edge pl-4 text-sm text-ash">{s.standards.affiliation}</p>
    </section>

    <section class="grid gap-6 md:grid-cols-3">
      {
        blocks.map((block) => (
          <article class="flex flex-col gap-3">
            <block.icon size={20} stroke-width={1.75} class="text-brand" aria-hidden="true" />
            <h2 class="font-bold">{block.title}</h2>
            <p class="text-sm leading-relaxed text-ash">{block.text}</p>
          </article>
        ))
      }
    </section>

    <section>
      <div class="flex items-center gap-3">
        <FileCheckCorner size={22} stroke-width={1.75} class="text-brand" aria-hidden="true" />
        <h2 class="text-xl font-bold">{s.verification.title}</h2>
      </div>
      <ol class="mt-6 grid gap-4 md:grid-cols-3">
        {
          s.verification.items.map((level, index) => (
            <li class="panel p-5">
              <span class="font-mono text-xs text-brand">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 font-bold">{level.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ash">{level.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="grid gap-4 md:grid-cols-[auto_1fr]">
      <Bug size={22} stroke-width={1.75} class="text-brand" aria-hidden="true" />
      <div>
        <h2 class="text-xl font-bold">{s.disclosure.title}</h2>
        <p class="mt-2 max-w-3xl leading-relaxed text-ash">{s.disclosure.text}</p>
        <a href={`${href(locale, "contact")}?topic=security`} class="mt-3 inline-block text-sm font-bold text-brand hover:underline">
          {t.cta.contact}
        </a>
      </div>
    </section>
  </div>
</Base>
