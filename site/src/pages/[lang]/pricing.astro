---
// No price and no seat count yet (docs/site.md §0): offers are described,
// prices will come from the offer configuration.
import { Check } from "@lucide/astro";
import Badge from "../../components/Badge.astro";
import LinkButton from "../../components/LinkButton.astro";
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { LOCALES, href, texts, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = texts(locale);
const p = t.pricing;
---

<Base locale={locale} title={p.title}>
  <PageHeader title={p.title} lead={p.lead} />

  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        p.plans.map((plan) => (
          <article class="panel flex flex-col p-6">
            <h2 class="text-lg font-bold">{plan.name}</h2>
            <p class="mt-1 text-sm text-ash">{plan.audience}</p>
            <div class="mt-5">
              <Badge tone="neutral">{p.notice}</Badge>
            </div>
            <ul class="mt-5 flex flex-1 flex-col gap-2">
              {plan.features.map((feature) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ash">
                  <Check size={16} class="mt-0.5 shrink-0 text-brand" aria-hidden="true" />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <div class="mt-10 flex justify-center">
      <LinkButton href={`${href(locale, "contact")}?topic=quote`} variant="primary">{t.cta.quote}</LinkButton>
    </div>
  </div>
</Base>
