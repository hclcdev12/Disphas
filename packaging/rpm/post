#!/bin/sh
# Oblivio %post (RPM): the helper's state tree, root only. Certificates are
# read through the helper (docs/protocole_ipc.md §10): no group, no account
# to add. RPM has no purge: removing the package keeps /var/lib/oblivio; to
# delete every data and setting: sudo rm -rf /var/lib/oblivio
state=/var/lib/oblivio
# Owned by root (docs/securite.md, S1). A symbolic link where a folder is
# expected means tampering: stop.
for path in "$state" "$state/keys" "$state/license" "$state/jobs" "$state/recovery" "$state/reports"; do
    if [ -L "$path" ]; then
        echo "oblivio: $path is a symbolic link, refusing to continue" >&2
        exit 1
    fi
done
mkdir -p "$state"
chown root:root "$state"
chmod 0700 "$state"
for sub in keys license jobs recovery reports; do
    mkdir -p "$state/$sub"
    chown root:root "$state/$sub"
    chmod 0700 "$state/$sub"
done
# Certificates stored by an earlier version (group-readable): root only.
find "$state/reports" -maxdepth 1 -type f \( -name '*.cose' -o -name '*.json' \) \
    -exec chown root:root {} + -exec chmod 0600 {} +
exit 0
