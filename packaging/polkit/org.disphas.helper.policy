<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  disphas root helper (docs/protocole_ipc.md §3). The application launches
  it once per session with pkexec; an administrator must authenticate every
  time (auth_admin, never kept), and only from an active local session.
-->
<policyconfig>
  <vendor>disphas</vendor>
  <action id="org.disphas.helper">
    <description>Run the disphas disk sanitization helper</description>
    <description xml:lang="fr">Exécuter le service d'effacement de disques disphas</description>
    <description xml:lang="de">Den disphas-Dienst zur Datenträgerlöschung ausführen</description>
    <message>disphas needs administrator rights to inspect and erase storage devices.</message>
    <message xml:lang="fr">disphas a besoin des droits administrateur pour inspecter et effacer des supports de stockage.</message>
    <message xml:lang="de">disphas benötigt Administratorrechte, um Datenträger zu prüfen und zu löschen.</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/disphas/disphas-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
