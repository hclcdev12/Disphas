# License signing service of the Oblivio license server
# (docs/licences_en_ligne.md §6.2). Install on the server only:
#   useradd --system --no-create-home --shell /usr/sbin/nologin oblivio-signer
#   usermod -aG oblivio-signer <site user>     # the site connects to the socket
#   install -m 0755 oblivio-signer /usr/local/bin/
#   install -m 0644 oblivio-signer.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now oblivio-signer
# Shop keys, certificates and the register live in /var/lib/oblivio-signer:
# exclude keys/ from backups; export the register daily (§6.5).

[Unit]
Description=Oblivio license signing service
After=local-fs.target

[Service]
Type=simple
User=oblivio-signer
Group=oblivio-signer
ExecStart=/usr/local/bin/oblivio-signer --state /var/lib/oblivio-signer serve --socket /run/oblivio-signer/signer.sock
Restart=on-failure

StateDirectory=oblivio-signer
StateDirectoryMode=0700
RuntimeDirectory=oblivio-signer
RuntimeDirectoryMode=0750
UMask=0077

# No network at all: the site talks to the Unix socket.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
