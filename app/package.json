{
  "name": "disphas-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bindings": "cd .. && cargo test -q -p disphas-protocol --features ts-rs export_bindings",
    "tauri": "tauri",
    "demo": "cargo build -q --manifest-path ../Cargo.toml -p disphas-helper --features demo && tauri dev",
    "build:demo": "tsc -b && VITE_DISPHAS_DEMO=1 vite build --base /demo/app/ --outDir dist-demo --emptyOutDir"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "~2.11.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
