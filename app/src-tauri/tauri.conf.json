{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oblivio",
  "version": "0.1.0",
  "identifier": "org.oblivio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oblivio",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#090D16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
