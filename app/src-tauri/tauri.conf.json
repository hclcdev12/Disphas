{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oblivio",
  "version": "0.1.0",
  "identifier": "org.oblivio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p oblivio-helper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oblivio",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#090D16",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Certified storage sanitization (NIST SP 800-88 / IEEE 2883)",
    "longDescription": "Oblivio inspects storage devices, decides the compliant sanitization method, erases, validates and issues a signed certificate verifiable offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1",
          "xdg-utils",
          "passwd",
          "libc6 (>= 2.35)",
          "libcairo2 (>= 1.10.0)",
          "libdbus-1-3 (>= 1.9.14)",
          "libgcc-s1 (>= 4.2)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libglib2.0-0t64 (>= 2.66.0) | libglib2.0-0 (>= 2.66.0)",
          "libgtk-3-0t64 (>= 3.21.5) | libgtk-3-0 (>= 3.21.5)",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)"
        ],
        "postInstallScript": "../../packaging/debian/postinst",
        "postRemoveScript": "../../packaging/debian/postrm",
        "files": {
          "/usr/libexec/oblivio/oblivio-helper": "../../target/release/oblivio-helper",
          "/usr/share/polkit-1/actions/org.oblivio.helper.policy": "../../packaging/polkit/org.oblivio.helper.policy",
          "/usr/share/doc/oblivio/THIRD-PARTY-NOTICES.txt": "../../packaging/THIRD-PARTY-NOTICES.txt",
          "/usr/share/doc/oblivio/manuel_operateur.md": "../../docs/manuel_operateur.md"
        }
      },
      "rpm": {
        "depends": [
          "/usr/bin/pkexec",
          "/usr/bin/xdg-open",
          "/usr/sbin/groupadd",
          "/usr/bin/getent",
          "libc.so.6(GLIBC_2.35)(64bit)",
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libgdk-3.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)",
          "libcairo.so.2()(64bit)",
          "libgdk_pixbuf-2.0.so.0()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libglib-2.0.so.0()(64bit)",
          "libgobject-2.0.so.0()(64bit)",
          "libgio-2.0.so.0()(64bit)"
        ],
        "files": {
          "/usr/libexec/oblivio/oblivio-helper": "../../target/release/oblivio-helper",
          "/usr/share/polkit-1/actions/org.oblivio.helper.policy": "../../packaging/polkit/org.oblivio.helper.policy",
          "/usr/share/doc/oblivio/THIRD-PARTY-NOTICES.txt": "../../packaging/THIRD-PARTY-NOTICES.txt",
          "/usr/share/doc/oblivio/manuel_operateur.md": "../../docs/manuel_operateur.md"
        },
        "postInstallScript": "../../packaging/rpm/post"
      }
    }
  }
}
